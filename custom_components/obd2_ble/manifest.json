{
  "domain": "obd2_ble",
  "name": "OBD2 BLE",
  "bluetooth": [
    {
      "local_name": "OBD2*"
    },
    {
      "local_name": "OBDII*"
    },
    {
      "local_name": "VEEPEAK*"
    },
    {
      "local_name": "Veepeak*"
    },
    {
      "local_name": "Viecar*"
    },
    {
      "local_name": "Vlink*"
    },
    {
